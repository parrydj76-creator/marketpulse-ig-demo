# Existing IG DEMO credentials must be set privately in Render Environment.
IG_ACCOUNT_TYPE=DEMO
ENABLE_IG_DEMO_ORDERS=false
ALLOW_EPHEMERAL_IG_DEMO=true
PERSISTENT_STORAGE_CONFIRMED=false
MP_MULTI_MODE=true
MP_AUTO_RESUME=false
AUTO_START_DEMO_TRADING=false
TEST_ONE_FOREX=false
MP_GLOBAL_DAILY_CAP=2
MP_GLOBAL_MAX_OPEN=1
# Never claim persistent storage on Render Free. With no durable execution journal,
# MP_AUTO_RESUME=true still FAILS CLOSED after restart to protect daily limits.
# Verify EACH instrument's dealing rules, point units, currencyCode, and order lifecycle.
# Pair configuration pattern: MP_<SIX_LETTER_PAIR>_<SETTING>
# Example EURUSD. Other pairs are discovered, but disabled until independently verified.
MP_EURUSD_ENABLED=false
MP_EURUSD_SIZE=1
MP_EURUSD_STOP_POINTS=12
MP_EURUSD_LIMIT_POINTS=18
MP_EURUSD_MAX_SPREAD_PRICE=0.00020
MP_EURUSD_MIN_SCORE=70
MP_EURUSD_VERIFIED_MIN_SIZE=1
MP_EURUSD_POINT_UNITS_VERIFIED=false
MP_EURUSD_LIFECYCLE_VERIFIED=false
MP_EURUSD_CURRENCY_CODE=
# Example for GBPJPY: MP_GBPJPY_ENABLED=false, MP_GBPJPY_SIZE=..., etc.
# Discovered instruments are not automatically approved for order execution.
MAX_STREAM_MARKETS=20
DISCOVERY_MARKET_LIMIT=150
