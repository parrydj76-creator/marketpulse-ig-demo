# MarketPulse V6.3 Major Forex — DEMO ONLY
IG_ACCOUNT_TYPE=DEMO
MP_MULTI_MODE=true
MP_MAJOR_FOREX_ONLY=true
MAX_STREAM_MARKETS=7
TEST_ONE_FOREX=false
PROBE_EURUSD_MINI=false
AUTO_DISCOVER_FOREX=false
REST_MAX_MARKETS=1
REST_POLL_SECONDS=300
ENABLE_IG_DEMO_ORDERS=false
MP_AUTO_RESUME=false
AUTO_START_DEMO_TRADING=false
MP_GLOBAL_DAILY_CAP=2
MP_GLOBAL_MAX_OPEN=1
PERSISTENT_STORAGE_CONFIRMED=false
ALLOW_EPHEMERAL_IG_DEMO=true
# Set IG_API_KEY, IG_USERNAME, IG_PASSWORD and ADMIN_TOKEN privately in Render.
# To enable a market, first verify its size, stop units, currencyCode, and demo lifecycle.
# Example only — do not copy unverified values to other markets:
MP_EURUSD_ENABLED=false
MP_EURUSD_SIZE=1
MP_EURUSD_STOP_POINTS=12
MP_EURUSD_LIMIT_POINTS=18
MP_EURUSD_MAX_SPREAD_PRICE=0.00020
MP_EURUSD_MIN_SCORE=70
MP_EURUSD_VERIFIED_MIN_SIZE=1
MP_EURUSD_POINT_UNITS_VERIFIED=false
MP_EURUSD_LIFECYCLE_VERIFIED=false
MP_EURUSD_CURRENCY_CODE=
# Other allowed prefixes: MP_GBPUSD_, MP_USDJPY_, MP_USDCHF_,
# MP_USDCAD_, MP_AUDUSD_, MP_NZDUSD_

# V6.3: ONLY set these after provisioning a real persistent disk, verifying
# the mount survives restart and reviewing the full IG order lifecycle.
MP_DURABLE_JOURNAL_VERIFIED=false
MP_JOURNAL_PATH=/var/data/marketpulse/multi-journal.json
# MP_AUTO_RESUME must remain false on Render Free.
