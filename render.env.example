# IG demo only. Keep order execution off until supervised testing succeeds.
IG_ACCOUNT_TYPE=DEMO
ENABLE_IG_DEMO_ORDERS=false
AUTO_START_DEMO_TRADING=false
IG_DEMO_ORDER_LIFECYCLE_VERIFIED=false
PERSISTENT_STORAGE_CONFIRMED=false
# Set only after mounting and testing persistent disk
DATA_DIR=/opt/render/project/src/data
# RENDER_DISK_MOUNT_PATH=/opt/render/project/src/data
IG_VERIFIED_MIN_SIZE=0
IG_VERIFIED_STOP_UNITS=false
DEMO_TRADE_SIZE=0
DEMO_STOP_DISTANCE=0
DEMO_LIMIT_DISTANCE=0
DEMO_MAX_SPREAD=0
DEMO_MIN_SCORE=70
DEMO_DAILY_CAP=2
# Keep IG_API_KEY, IG_USERNAME, IG_PASSWORD, ADMIN_TOKEN in Render secrets only.
